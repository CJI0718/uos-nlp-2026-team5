{
  "mcpServers": {
    "factcheck-mission": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "scripts/mcp_stdio.py",
        "--arm",
        "C2",
        "--live-web",
        "--web-only",
        "--allow-user-claims",
        "--no-preset-claims",
        "--harness-v3",
        "--block-self-citation",
        "--max-tool-calls",
        "32",
        "--max-external-calls",
        "15",
        "--model-id",
        "claude-code-interactive",
        "--run-id",
        "dev-interactive",
        "--out",
        "results/raw/dev-interactive/run.jsonl",
        "--missions-dir",
        "results/raw/dev-interactive/missions"
      ]
    }
  }
}
